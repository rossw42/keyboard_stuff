{
    "name":  "kle-to-scad",
    "version":  "1.0.0",
    "description":  "Convert Keyboard Layout Editor (KLE) JSON files to OpenSCAD layouts for hotswap_pcb_generator",
    "main":  "index.js",
    "bin":  {
                "kle-to-scad":  "./index.js"
            },
    "directories":  {
                        "doc":  "docs",
                        "example":  "examples",
                        "test":  "test"
                    },
    "scripts":  {
                    "test":  "node index.js test_40percent.json -v",
                    "start":  "node index.js"
                },
    "keywords":  [
                     "keyboard",
                     "kle",
                     "ergogen",
                     "pcb",
                     "mechanical-keyboard",
                     "converter"
                 ],
    "author":  "",
    "license":  "MIT",
    "dependencies":  {
                         "@ijprest/kle-serial":  "^0.15.1",
                         "commander":  "^14.0.0",
                         "js-yaml":  "^4.1.0"
                     }
}
